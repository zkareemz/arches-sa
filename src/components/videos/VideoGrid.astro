---
import type { ProjectVideo } from "../../data/content";

import VideoCard from "./VideoCard.astro";

interface Props {
  videos: ProjectVideo[];
  locale: "ar" | "en";
  limit?: number;
  class?: string;
}

const { videos, locale, limit, class: className } = Astro.props;
const orderedVideos = videos
  .filter((video) => video.published)
  .sort((a, b) => {
    const featuredOrder =
      Number(b.featured ?? false) - Number(a.featured ?? false);
    if (featuredOrder !== 0) return featuredOrder;
    if (a.publishedAt && b.publishedAt) {
      return b.publishedAt.localeCompare(a.publishedAt);
    }
    if (a.publishedAt) return -1;
    if (b.publishedAt) return 1;
    return 0;
  });
const visibleVideos =
  limit === undefined ? orderedVideos : orderedVideos.slice(0, limit);
---

<div
  class:list={[
    "grid",
    "grid-cols-1",
    "gap-x-6",
    "gap-y-10",
    "sm:grid-cols-2",
    "lg:grid-cols-3",
    className,
  ]}
>
  {visibleVideos.map((video) => <VideoCard video={video} locale={locale} />)}
</div>

<script>
  const trackVideoCard = (eventName: string) => {
    (window as Window & { plausible?: (name: string) => void }).plausible?.(
      eventName,
    );
  };
  document
    .querySelectorAll<HTMLAnchorElement>("[data-video-card]")
    .forEach((card) => {
      card.addEventListener("click", () => trackVideoCard("Video Card Click"));
    });
</script>
