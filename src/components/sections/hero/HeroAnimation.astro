---
import type { SiteContent } from "../../../data/content";

import { whatsappUrl } from "../../../data/content";
import Button from "../../../ui/Button.astro";
import Eyebrow from "../../../ui/Eyebrow.astro";

interface Props {
  delay?: number; // ms before circle starts growing
  duration?: number; // ms for circle to fully expand
  easing?: string; // CSS easing function
  contentDelay?: number; // seconds to delay the content animation (layer 3)
  content: SiteContent;
}

const {
  delay = 0,
  duration = 800,
  easing = "cubic-bezier(0.22, 1, 0.36, 1)",
  contentDelay = 0,
  content,
} = Astro.props;

const { hero } = content;
---

<section
  style={`--content-delay: ${contentDelay}s; --scrim-at: ${2.5 + contentDelay}s`}
  class:list={[
    "hero",
    "relative",
    "flex",
    "min-h-svh",
    "flex-col",
    "justify-center",
    "overflow-hidden",
    "text-quill-gray-50",
    "z-10",
  ]}
>
  <!-- Layer 1: Video (revealed through the expanding circle) -->
  <video
    id="hero-video"
    data-hero-video
    poster="/background-video-poster.jpg"
    aria-hidden="true"
    autoplay
    muted
    playsinline
    loop
    preload="auto"
    class:list={[
      "absolute",
      "inset-0",
      "h-full",
      "w-full",
      "object-cover",
      "z-0",
    ]}
  >
    <source src="/background.mp4" type="video/mp4" />
    <source src="/background.webm" type="video/webm" />
  </video>

  <!-- Layer 2: Static image (masked away by the growing circle) -->
  <div
    id="hero-overlay"
    class:list={[
      "absolute",
      "inset-0",
      "h-full",
      "w-full",
      "min-h-svh",
      "bg-cover",
      "bg-center",
      "z-10",
    ]}
    style={{
      backgroundImage: "url('/background.jpg')",
    }}
  >
  </div>
  <!-- Layer 3: content -->
  <div
    class:list={[
      "relative",
      "z-30",
      "mx-auto",
      "w-full",
      "max-w-7xl",
      "px-6",
      "pb-24",
      "pt-32",
      "sm:px-10",
    ]}
  >
    <div class:list={["flex", "flex-col", "gap-6"]}>
      <span class="hero__item" style="--i: 0">
        <Eyebrow text={hero.eyebrow} tone="light" bar />
      </span>
      <h1
        class:list={[
          "hero__item",
          "max-w-4xl",
          "text-balance",
          "text-5xl",
          "font-light",
          "leading-[1.04]",
          "tracking-tight",
          "sm:text-7xl",
          "lg:text-8xl",
        ]}
        style="--i: 1"
      >
        {hero.title}
      </h1>
      <p
        class:list={[
          "hero__item",
          "max-w-xl",
          "text-lg",
          "leading-relaxed",
          "text-quill-gray-300",
        ]}
        style="--i: 2"
      >
        {hero.p}
      </p>
      <div class="hero__item mt-4" style="--i: 3">
        <Button
          href={whatsappUrl(content)}
          label={hero.cta}
          variant="primary"
        />
      </div>
    </div>
  </div>
  <div
    aria-hidden="true"
    class:list={[
      "hero__scrim",
      "absolute",
      "inset-0",
      "z-20",
      "bg-ink-950/20",
      "bg-linear-to-t",
      "from-ink-950/85",
      "via-ink-950/30",
      "to-ink-950/0",
    ]}
  >
  </div>
</section>

<style>
  .hero__scrim {
    opacity: 1;
    animation: none;
    pointer-events: none;
  }

  .hero__item {
    opacity: 1;
    animation: hero-rise 0.75s cubic-bezier(0.22, 1, 0.36, 1)
      calc(var(--i) * 0.08s) forwards;
  }

  @keyframes hero-rise {
    from {
      opacity: 1;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #hero-overlay {
      display: none;
    }

    .hero__item {
      opacity: 1;
      transform: none;
      animation: none;
    }
  }
</style>

<script is:inline define:vars={{ delay, duration, easing }}>
  (function () {
    var video = document.querySelector("[data-hero-video]");

    if (!video) return;

    var overlay = document.getElementById("hero-overlay");
    if (!video || !overlay) return;

    var reduceMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;
    if (reduceMotion) {
      overlay.style.display = "none";
      video.removeAttribute("autoplay");
      video.pause();
      video.dataset.heroState = "reduced-motion";
      return;
    }

    // ── Parse easing ────────────────────────────────────────
    function parseEasing(raw) {
      var cbMatch = raw.match(
        /cubic-bezier\(\s*([\d.]+)\s*,\s*([\d.]+)\s*,\s*([\d.]+)\s*,\s*([\d.]+)\s*\)/,
      );
      if (cbMatch) {
        var x1 = parseFloat(cbMatch[1]);
        var y1 = parseFloat(cbMatch[2]);
        var x2 = parseFloat(cbMatch[3]);
        var y2 = parseFloat(cbMatch[4]);
        return function (t) {
          return solveBezier(t, x1, y1, x2, y2);
        };
      }
      switch (raw) {
        case "ease-in":
          return function (t) {
            return t * t;
          };
        case "ease-out":
          return function (t) {
            return 1 - Math.pow(1 - t, 3);
          };
        case "ease-in-out":
          return function (t) {
            return t < 0.5 ? 2 * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;
          };
        case "linear":
          return function (t) {
            return t;
          };
        default:
          return function (t) {
            return 1 - Math.pow(1 - t, 3);
          };
      }
    }

    function solveBezier(t, x1, y1, x2, y2) {
      function sx(u) {
        return (
          ((1 - 3 * x2 + 3 * x1) * u + (3 * x2 - 6 * x1)) * u * u + 3 * x1 * u
        );
      }
      function sy(u) {
        return (
          ((1 - 3 * y2 + 3 * y1) * u + (3 * y2 - 6 * y1)) * u * u + 3 * y1 * u
        );
      }
      function dx(u) {
        return (
          (3 * (1 - 3 * x2 + 3 * x1) * u + 2 * (3 * x2 - 6 * x1)) * u + 3 * x1
        );
      }
      var u = t;
      for (var i = 0; i < 8; i++) {
        var err = sx(u) - t;
        if (Math.abs(err) < 1e-7) break;
        u -= err / dx(u);
      }
      return sy(u);
    }

    var easeFn = parseEasing(easing);

    // ── Animate ─────────────────────────────────────────────
    // Max radius: half the viewport diagonal (covers all corners)
    var maxRadius = Math.hypot(window.innerWidth, window.innerHeight) / 2;

    function buildMask(r) {
      // Create a visible ring at the circle edge
      var ringWidth = 3; // px
      var inner = Math.max(0, r - ringWidth);
      return (
        "radial-gradient(circle at center, transparent " +
        inner +
        "px, rgba(255,255,255,0.5) " +
        inner +
        "px, rgba(255,255,255,0.5) " +
        r +
        "px, black " +
        r +
        "px)"
      );
    }

    // Set initial mask (circle at 0)
    overlay.style.setProperty("-webkit-mask-image", buildMask(0));
    overlay.style.setProperty("mask-image", buildMask(0));

    var playbackTimeout = 2500;
    var staticFallback = false;
    var wipeStarted = false;
    var wipeComplete = false;

    function useStaticFallback(reason, error) {
      if (staticFallback) return;

      staticFallback = true;
      video.removeAttribute("autoplay");
      video.pause();
      video.dataset.heroState = "fallback-" + reason;
      console.warn(
        "Hero video is unavailable; continuing with the static hero.",
        reason,
        error,
      );
    }

    function startPlayback() {
      var playResult;

      video.dataset.heroState = "play-pending";

      try {
        playResult = video.play();
      } catch (error) {
        useStaticFallback("exception", error);
        return;
      }

      // Very old browsers did not return a Promise from play(). In that case,
      // let the media events below report the eventual state.
      if (!playResult || typeof playResult.then !== "function") return;

      var settled = false;
      var timeoutId = window.setTimeout(function () {
        if (settled) return;
        settled = true;
        useStaticFallback(
          "timeout",
          new Error("Playback did not start in time."),
        );
      }, playbackTimeout);

      playResult
        .then(function () {
          if (settled || staticFallback) {
            video.pause();
            return;
          }

          settled = true;
          window.clearTimeout(timeoutId);
          video.dataset.heroState = "playing";

          // If playback became ready while the wipe was running, restart at
          // the opening frame so the reveal still shows the intended sequence.
          if (wipeStarted && !wipeComplete) {
            video.currentTime = 0;
          }
        })
        .catch(function (error) {
          if (settled) return;
          settled = true;
          window.clearTimeout(timeoutId);
          useStaticFallback(
            error && error.name === "NotAllowedError" ? "policy" : "media",
            error,
          );
        });
    }

    function startWipe() {
      wipeStarted = true;

      if (!staticFallback && !video.paused) {
        video.currentTime = 0;
      }

      var startTime = performance.now();

      function tick(now) {
        var elapsed = now - startTime;
        var progress = Math.min(elapsed / duration, 1);
        var eased = easeFn(progress);
        var r = eased * maxRadius;
        var mask = buildMask(r);

        overlay.style.setProperty("-webkit-mask-image", mask);
        overlay.style.setProperty("mask-image", mask);

        if (progress < 1) {
          requestAnimationFrame(tick);
        } else {
          wipeComplete = true;

          // Removing the overlay guarantees a usable final state even when a
          // browser does not support the animated CSS mask.
          overlay.style.display = "none";
        }
      }

      requestAnimationFrame(tick);
    }

    video.addEventListener("playing", function () {
      if (!staticFallback) video.dataset.heroState = "playing";
    });
    video.addEventListener("error", function () {
      useStaticFallback("media", video.error);
    });

    function scheduleWipe() {
      if (delay > 0) {
        setTimeout(startWipe, delay);
      } else {
        startWipe();
      }
    }

    // Playback and the visual reveal deliberately run independently. A slow,
    // blocked, or unsupported video can no longer leave the mask at radius 0.
    // The reveal clock starts only after the full page has loaded.
    startPlayback();
    if (document.readyState === "complete") {
      scheduleWipe();
    } else {
      window.addEventListener("load", scheduleWipe, { once: true });
    }
  })();
</script>
