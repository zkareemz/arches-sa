---
import type { SiteContent } from "../../../data/content";

import { gallery } from "../../../data/gallery";
import Reveal from "../../../ui/Reveal.astro";
import SectionHeader from "../../../ui/SectionHeader.astro";

interface Props {
  content: SiteContent;
}

const { content } = Astro.props;
const { projects } = content;
const labels = content.ui.gallery;
const categoryTitle = (slug: string) =>
  ({
    residential: labels.residential,
    interior: labels.interior,
    commercial: labels.commercial,
  })[slug] ?? projects.title;

// Image paths in gallery.json are public-root-relative WITHOUT a leading slash —
// prepend "/" so they resolve from the site root.
const withBase = (p: string) => `/${p}`;

// One entry per category. A category's pool is the union of its direct images and
// every sub-project's images. Skip categories that have no photos.
const categories = gallery.categories
  .map((cat) => ({
    slug: cat.slug,
    title: categoryTitle(cat.slug),
    photos: [...cat.images, ...cat.projects.flatMap((p) => p.images)].map(
      (img, i) => ({
        full: withBase(img.full),
        thumb: withBase(img.thumb),
        width: img.width,
        height: img.height,
        alt: `${categoryTitle(cat.slug)} — ${content.ui.projectExamples} — ${labels.image} ${i + 1}`,
      }),
    ),
  }))
  .filter((cat) => cat.photos.length > 0);

const photoLabel = (n: number) =>
  content.dir === "rtl" ? labels.image : n === 1 ? "photo" : "photos";
---

<section
  id="projects"
  class:list={["overflow-hidden", "bg-surface", "text-heading"]}
>
  <div
    class:list={[
      "mx-auto",
      "w-full",
      "max-w-7xl",
      "px-6",
      "pt-24",
      "sm:px-10",
      "sm:pt-32",
    ]}
  >
    <Reveal>
      <SectionHeader
        eyebrow={projects.eyebrow}
        title={projects.title}
        intro={projects.intro}
      />
    </Reveal>

    <div
      class:list={[
        "mt-14",
        "grid",
        "grid-cols-1",
        "gap-6",
        "pb-24",
        "sm:mt-20",
        "sm:grid-cols-3",
        "sm:pb-32",
      ]}
    >
      {
        categories.map((cat, i) => {
          const cover = cat.photos[0];
          const num = String(i + 1).padStart(2, "0");
          return (
            <Reveal delay={i * 120}>
              <button
                type="button"
                data-cat-index={i}
                aria-label={`${labels.open}: ${cat.title} (${cat.photos.length} ${photoLabel(cat.photos.length)})`}
                class:list={[
                  "group",
                  "relative",
                  "block",
                  "aspect-[3/4]",
                  "w-full",
                  "overflow-hidden",
                  "rounded-sm",
                  "text-start",
                  "transition-transform",
                  "duration-500",
                  "ease-out",
                  "hover:-translate-y-1",
                  "focus:outline-none",
                  "focus-visible:ring-2",
                  "focus-visible:ring-clay-500",
                  "focus-visible:ring-offset-2",
                  "focus-visible:ring-offset-surface",
                ]}
              >
                <div class="absolute inset-0 transition-transform duration-[900ms] ease-out group-hover:scale-[1.06]">
                  <img
                    data-random
                    src={cover.thumb}
                    srcset={`${cover.thumb} 480w, ${cover.full} 1920w`}
                    sizes="(min-width: 640px) 33vw, 100vw"
                    width={cover.width}
                    height={cover.height}
                    alt={cover.alt}
                    loading="lazy"
                    decoding="async"
                    class="animate-kenburns h-full w-full object-cover"
                  />
                </div>

                <div class="absolute inset-0 bg-linear-to-t from-ink-950/85 via-ink-950/15 to-transparent" />

                <span class="pointer-events-none absolute start-4 top-2 text-6xl font-light leading-none tabular-nums text-quill-gray-50/40 transition-colors duration-500 group-hover:text-quill-gray-50/75 sm:text-7xl">
                  {num}
                </span>

                <span class="absolute inset-x-5 bottom-5 flex flex-col gap-1">
                  <span class="text-xl font-light text-quill-gray-50">
                    {cat.title}
                  </span>
                  <span class="text-sm text-quill-gray-300">
                    {cat.photos.length} {photoLabel(cat.photos.length)}
                  </span>
                </span>
              </button>
            </Reveal>
          );
        })
      }
    </div>

    <div class="border-t border-rule py-16 sm:py-20">
      <Reveal>
        <h3 class="text-2xl font-light text-heading sm:text-3xl">
          {projects.videoGalleryTitle}
        </h3>
      </Reveal>

      <div
        class:list={[
          "mt-8",
          "grid",
          "grid-cols-1",
          "gap-6",
          "sm:mt-10",
          "sm:grid-cols-3",
        ]}
      >
        {
          projects.videos.map((video, i) => (
            <Reveal delay={i * 120}>
              <button
                type="button"
                data-video-trigger
                data-video-id={video.id}
                data-video-title={video.title}
                aria-label={`${labels.playVideo}: ${video.title}`}
                class:list={[
                  "group",
                  "relative",
                  "block",
                  "aspect-video",
                  "w-full",
                  "overflow-hidden",
                  "rounded-sm",
                  "text-start",
                  "transition-transform",
                  "duration-500",
                  "ease-out",
                  "hover:-translate-y-1",
                  "focus:outline-none",
                  "focus-visible:ring-2",
                  "focus-visible:ring-clay-500",
                  "focus-visible:ring-offset-2",
                  "focus-visible:ring-offset-surface",
                ]}
              >
                <img
                  src={`https://i.ytimg.com/vi/${video.id}/hqdefault.jpg`}
                  alt={video.title}
                  width="480"
                  height="360"
                  loading="lazy"
                  decoding="async"
                  class="h-full w-full object-cover transition-transform duration-[900ms] ease-out group-hover:scale-[1.06]"
                />

                <span class="absolute inset-0 bg-ink-950/35 transition-colors duration-500 group-hover:bg-ink-950/15" />

                <span class="absolute inset-0 grid place-items-center">
                  <span class="grid h-14 w-14 place-items-center rounded-full border border-quill-gray-50/80 bg-ink-950/35 text-quill-gray-50 backdrop-blur transition-transform duration-500 group-hover:scale-110">
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="22"
                      height="22"
                      viewBox="0 0 24 24"
                      fill="currentColor"
                      aria-hidden="true"
                      class="translate-x-px rtl:-translate-x-px"
                    >
                      <path d="M8 5.14v13.72a1 1 0 0 0 1.51.86l10.62-6.86a1 1 0 0 0 0-1.72L9.51 4.28A1 1 0 0 0 8 5.14Z" />
                    </svg>
                  </span>
                </span>

                <span class="absolute inset-x-4 bottom-4 text-base font-light text-quill-gray-50 sm:inset-x-5 sm:bottom-5 sm:text-lg">
                  {video.title}
                </span>
              </button>
            </Reveal>
          ))
        }
      </div>
    </div>
  </div>

  {/* Model consumed by src/scripts/gallery.ts (randomiser + lightbox). */}
  <script
    is:inline
    type="application/json"
    id="gallery-data"
    set:html={JSON.stringify(categories).replace(/</g, "\\u003c")}
  />

  <div
    id="gallery-lightbox"
    data-photo-label={labels.image}
    data-fullscreen-label={labels.fullscreen}
    data-exit-fullscreen-label={labels.exitFullscreen}
    role="dialog"
    aria-modal="true"
    aria-label={projects.title}
    class:list={["fixed", "inset-0", "z-[60]"]}
  >
    <div
      class="relative flex h-full w-full flex-col bg-ink-950/95 text-quill-gray-50"
    >
      {/* Top bar */}
      <div
        class="relative z-10 flex items-center justify-between gap-4 px-4 py-4 sm:px-6"
      >
        <div class="flex items-baseline gap-3">
          <span data-title class="text-base font-light sm:text-lg"></span>
          <span data-counter class="text-sm tabular-nums text-quill-gray-400"
          ></span>
        </div>
        <div class="flex items-center gap-1">
          <button
            type="button"
            data-fullscreen
            aria-label={labels.fullscreen}
            class:list={[
              "grid",
              "h-10",
              "w-10",
              "place-items-center",
              "rounded-full",
              "text-quill-gray-200",
              "transition",
              "hover:bg-quill-gray-50/10",
              "hover:text-quill-gray-50",
            ]}
          >
            <svg
              data-fs-enter
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M4 9V5a1 1 0 0 1 1-1h4"></path>
              <path d="M20 9V5a1 1 0 0 0-1-1h-4"></path>
              <path d="M4 15v4a1 1 0 0 0 1 1h4"></path>
              <path d="M20 15v4a1 1 0 0 1-1 1h-4"></path>
            </svg>
            <svg
              data-fs-exit
              style="display:none"
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M8 4v3a1 1 0 0 1-1 1H4"></path>
              <path d="M16 4v3a1 1 0 0 0 1 1h3"></path>
              <path d="M8 20v-3a1 1 0 0 0-1-1H4"></path>
              <path d="M16 20v-3a1 1 0 0 1 1-1h3"></path>
            </svg>
          </button>
          <button
            type="button"
            data-close
            aria-label={labels.close}
            class:list={[
              "grid",
              "h-10",
              "w-10",
              "place-items-center",
              "rounded-full",
              "text-quill-gray-200",
              "transition",
              "hover:bg-quill-gray-50/10",
              "hover:text-quill-gray-50",
            ]}
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="22"
              height="22"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              aria-hidden="true"
            >
              <path d="M6 6l12 12M18 6L6 18"></path>
            </svg>
          </button>
        </div>
      </div>

      {/* Stage */}
      <div
        data-close-area
        class="relative flex min-h-0 flex-1 items-center justify-center px-4 sm:px-16"
      >
        <button
          type="button"
          data-prev
          aria-label={labels.previous}
          class:list={[
            "absolute",
            "start-2",
            "z-10",
            "grid",
            "h-11",
            "w-11",
            "place-items-center",
            "rounded-full",
            "bg-ink-950/40",
            "text-quill-gray-100",
            "backdrop-blur",
            "transition",
            "hover:bg-ink-950/70",
            "hover:text-quill-gray-50",
            "sm:h-12",
            "sm:w-12",
          ]}
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            class="rtl:rotate-180"
          >
            <path d="M15 5l-7 7 7 7"></path>
          </svg>
        </button>

        <img
          data-stage
          alt=""
          decoding="async"
          draggable="false"
          class="max-h-full max-w-full object-contain"
        />

        <button
          type="button"
          data-next
          aria-label={labels.next}
          class:list={[
            "absolute",
            "end-2",
            "z-10",
            "grid",
            "h-11",
            "w-11",
            "place-items-center",
            "rounded-full",
            "bg-ink-950/40",
            "text-quill-gray-100",
            "backdrop-blur",
            "transition",
            "hover:bg-ink-950/70",
            "hover:text-quill-gray-50",
            "sm:h-12",
            "sm:w-12",
          ]}
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            class="rtl:rotate-180"
          >
            <path d="M9 5l7 7-7 7"></path>
          </svg>
        </button>
      </div>

      {/* Dot indicators — mobile */}
      <div
        data-dots
        class="flex flex-wrap items-center justify-center gap-2 px-4 py-4 sm:hidden"
      >
      </div>

      {/* Thumbnail strip — desktop */}
      <div
        data-thumbs
        class:list={[
          "hidden",
          "items-center",
          "gap-2",
          "overflow-x-auto",
          "px-6",
          "py-4",
          "sm:flex",
          "[&::-webkit-scrollbar]:hidden",
        ]}
      >
      </div>
    </div>
  </div>

  <dialog
    id="video-gallery-modal"
    aria-labelledby="video-gallery-title"
    class="fixed inset-0 m-0 h-full max-h-none w-full max-w-none border-0 bg-ink-950/95 px-4 py-6 text-quill-gray-50 sm:px-10 sm:py-10"
  >
    <div
      data-video-backdrop
      class="flex h-full w-full items-center justify-center"
    >
      <div class="relative w-full max-w-5xl">
        <button
          type="button"
          data-video-close
          aria-label={labels.closeVideo}
          class:list={[
            "absolute",
            "-end-1",
            "-top-12",
            "grid",
            "h-10",
            "w-10",
            "place-items-center",
            "rounded-full",
            "text-quill-gray-200",
            "transition",
            "hover:bg-quill-gray-50/10",
            "hover:text-quill-gray-50",
            "focus:outline-none",
            "focus-visible:ring-2",
            "focus-visible:ring-clay-500",
          ]}
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="22"
            height="22"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <path d="M6 6l12 12M18 6L6 18"></path>
          </svg>
        </button>

        <h3 id="video-gallery-title" class="mb-4 text-lg font-light sm:text-xl">
        </h3>
        <div
          data-video-player
          class="aspect-video overflow-hidden rounded-sm bg-ink-900"
        >
        </div>
      </div>
    </div>
  </dialog>

  <script>
    import "../../../scripts/gallery.ts";
    import "../../../scripts/video-gallery.ts";
  </script>
</section>
