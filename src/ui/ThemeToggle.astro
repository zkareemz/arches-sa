---
import Moon from "../assets/moon.svg";
import Sun from "../assets/sun.svg";

interface Props {
  darkLabel: string;
  lightLabel: string;
  systemLabel: string;
  class?: string;
}

const { darkLabel, lightLabel, systemLabel, class: className } = Astro.props;
---

<button
  type="button"
  data-theme-toggle
  data-dark-label={darkLabel}
  data-light-label={lightLabel}
  data-system-label={systemLabel}
  aria-label={darkLabel}
  title={darkLabel}
  class:list={[
    "relative flex h-10 w-10 cursor-pointer items-center justify-center rounded-full text-heading transition-colors hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent",
    className,
  ]}
>
  <Moon
    data-theme-icon="moon"
    class:list={[
      "absolute h-5 w-5 scale-100 opacity-100 transition duration-300",
      "motion-reduce:transition-none",
    ]}
    aria-hidden="true"
  />
  <Sun
    data-theme-icon="sun"
    class:list={[
      "absolute h-5 w-5 scale-75 opacity-0 transition duration-300",
      "motion-reduce:transition-none",
    ]}
    aria-hidden="true"
  />
</button>

<style>
  :global(html:has(> head > meta[name="color-scheme"][content="dark"]))
    [data-theme-icon="moon"] {
    opacity: 0;
    transform: scale(0.75);
  }

  :global(html:has(> head > meta[name="color-scheme"][content="dark"]))
    [data-theme-icon="sun"] {
    opacity: 1;
    transform: scale(1);
  }

  @media (prefers-color-scheme: dark) {
    :global(
        html:not(:has(> head > meta[name="color-scheme"][content="light"]))
      )
      [data-theme-icon="moon"] {
      opacity: 0;
      transform: scale(0.75);
    }

    :global(
        html:not(:has(> head > meta[name="color-scheme"][content="light"]))
      )
      [data-theme-icon="sun"] {
      opacity: 1;
      transform: scale(1);
    }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>(
    "[data-theme-toggle]",
  );
  const KEY = "arches-theme";
  const scheme = matchMedia("(prefers-color-scheme: dark)");

  const pinnedTheme = () => {
    try {
      const value = localStorage.getItem(KEY);
      return value === "light" || value === "dark" ? value : null;
    } catch {
      return null;
    }
  };

  // Label always describes the next action: pin the opposite of the system
  // scheme, or (when pinned) go back to following the system.
  const sync = () => {
    if (!toggle) return;
    const pinned = pinnedTheme();
    const dark = pinned ? pinned === "dark" : scheme.matches;
    const label = pinned
      ? toggle.dataset.systemLabel
      : dark
        ? toggle.dataset.lightLabel
        : toggle.dataset.darkLabel;
    toggle.ariaLabel = label ?? "";
    toggle.title = label ?? "";
  };

  sync();

  toggle?.addEventListener("click", () => {
    try {
      if (pinnedTheme()) localStorage.removeItem(KEY);
      else localStorage.setItem(KEY, scheme.matches ? "light" : "dark");
    } catch {}
    dispatchEvent(new Event("arches-theme-change"));
    sync();
  });

  scheme.addEventListener("change", sync);
  addEventListener("storage", sync);
</script>
